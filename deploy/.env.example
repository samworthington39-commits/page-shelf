# Docker image tag. Use latest, v1.0.8, or another published release tag.
PAGE_SHELF_VERSION=latest
PAGE_SHELF_PORT=8000

# Host paths. The library is mounted read-only inside the container.
PAGE_SHELF_LIBRARY_DIR=./library
PAGE_SHELF_DATA_DIR=./data

# Initial password only. First login requires changing it immediately.
ADMIN_PASSWORD=112233
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=24

AUTO_SCAN_POLL_SECONDS=30
STORAGE_AUTO_DISCOVER_MOUNTS=true
STORAGE_EXCLUDED_ROOTS=/data
STORAGE_ALLOWED_ROOTS=
CORS_ORIGINS=
ENABLE_API_DOCS=false
