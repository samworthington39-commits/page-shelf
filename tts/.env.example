# Host port published by Docker Compose.
TTS_PORT=8010

# Qwen3-TTS 0.6B CustomVoice model used by the experimental service.
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_RUNTIME=openvino
TTS_OPENVINO_DEVICE=GPU
TTS_OPENVINO_ALLOW_CPU_FALLBACK=true
TTS_OPENVINO_AUTO_CONVERT=true
TTS_DEFAULT_VOICE=Serena
TTS_DEFAULT_LANGUAGE=Chinese
TTS_MAX_INPUT_CHARS=500

# Leave empty only on a trusted private network.
TTS_API_KEY=

# 0 lets PyTorch choose. Set this to the physical core count when tuning.
TTS_TORCH_THREADS=0
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# On the NAS, query both device group ids with:
# stat -c '%g' /dev/dri/renderD128
# stat -c '%g' /dev/dri/card0
TTS_DRI_GID=109
TTS_VIDEO_GID=44

# The official endpoint is the default. A compatible mirror can be supplied
# when the Docker host cannot reach Hugging Face.
HF_ENDPOINT=https://huggingface.co
