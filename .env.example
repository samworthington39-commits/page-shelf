DATABASE_URL=sqlite:///./data/bookshelf.db
LIBRARY_PATH=./library
COVER_PATH=./data/covers
CORS_ORIGINS=
# 默认关闭浏览器跨域访问；确有独立 Web 前端时填写明确来源，多个来源用英文逗号分隔。
ENABLE_API_DOCS=false
# 仅用于首次初始化；首次登录默认密码为 112233，后台会要求立即修改。
ADMIN_PASSWORD=112233
# 可留空，首次启动会自动生成并持久化随机会话密钥。
ADMIN_SESSION_SECRET=
ADMIN_CREDENTIALS_PATH=./data/admin_credentials.json
ADMIN_SESSION_HOURS=24
AUTO_SCAN_POLL_SECONDS=30
# Docker 中默认自动发现 NAS 管理界面添加的目录挂载；/data 是数据库内部目录，不作为书架。
STORAGE_AUTO_DISCOVER_MOUNTS=true
STORAGE_EXCLUDED_ROOTS=/data
# 可选：额外显式授权的容器内路径，多个路径用英文逗号分隔。
STORAGE_ALLOWED_ROOTS=
# Docker Hub 不可达时可改为 m.daocloud.io/docker.io/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim
